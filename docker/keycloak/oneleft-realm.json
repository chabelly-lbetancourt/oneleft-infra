{
  "realm": "oneleft",
  "displayName": "OneLeft",
  "loginTheme": "oneleft",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": true,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es",
    "en"
  ],
  "defaultLocale": "es",
  "smtpServer": {
    "host": "${SMTP_HOST:mailpit}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:no-reply@oneleft.dev}",
    "fromDisplayName": "OneLeft",
    "auth": "${SMTP_AUTH:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}",
    "starttls": "${SMTP_STARTTLS:false}",
    "ssl": "${SMTP_SSL:false}"
  },
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Usuario de OneLeft"
      },
      {
        "name": "admin",
        "description": "Administrador y moderador"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "clientId": "oneleft-web",
      "name": "OneLeft · web and Android app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##https://localhost/*##oneleft://*"
      },
      "redirectUris": [
        "http://localhost:4200/*",
        "https://localhost/*",
        "oneleft://*",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "https://localhost",
        "http://localhost:8080"
      ]
    },
    {
      "clientId": "oneleft-api",
      "name": "OneLeft · API (integration tests)",
      "publicClient": false,
      "secret": "oneleft-api-dev-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "displayName": "Google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "guiOrder": "1",
        "hideOnLoginPage": "false"
      }
    }
  ],
  "users": [
    {
      "id": "a624d063-bd1e-442d-b52d-8de2df356c13",
      "username": "ana@oneleft.dev",
      "email": "ana@oneleft.dev",
      "firstName": "Ana",
      "lastName": "Pruebas",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ana-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "id": "9e51a057-ce42-4177-b020-ac2fc7ec6ffa",
      "username": "admin@oneleft.dev",
      "email": "admin@oneleft.dev",
      "firstName": "Admin",
      "lastName": "Pruebas",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ]
    },
    {
      "id": "5b0f7c2e-8d4a-4f3b-9c61-2e7a9d4b8f10",
      "username": "lucia@oneleft.dev",
      "email": "lucia@oneleft.dev",
      "firstName": "Lucía",
      "lastName": "Pruebas",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "lucia-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
  ]
}
