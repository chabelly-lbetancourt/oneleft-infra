# Environment of a deployed instance (pre or pro) for compose.prod.yaml. On the instance: cp .env.prod.example .env,
# fill it in and keep it there only (it is not committed). Every password must be long and random, for example
#   openssl rand -base64 32

# Public host name of the environment (its DNS record points to the static IP of the instance) and the email that
# Let's Encrypt uses to warn about certificates
ONELEFT_DOMAIN=oneleft.example.com
ACME_EMAIL=admin@example.com

# Published images (GHCR): latest in pro, pre in pre. The instance runs docker login ghcr.io once, with a token that
# can only read packages
ONELEFT_IMAGES=ghcr.io/chabelly-lbetancourt/oneleft-
ONELEFT_IMAGE_TAG=latest
# pro: empty (never the demo data). pre: seed, to load the demo profiles and plans
SPRING_PROFILES_ACTIVE=

POSTGRES_USER=oneleft
POSTGRES_PASSWORD=
RABBITMQ_USER=oneleft
RABBITMQ_PASSWORD=
# Administrator of the Keycloak console (https://<domain>/auth/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Secret of the oneleft-accounts client of Keycloak (HU-045): the users service deletes accounts with it. Long and random;
# it is read when the realm is imported, so it is set before the first start
ACCOUNTS_CLIENT_SECRET=

# Google as identity provider (HU-021): OAuth client with the redirect URI
# https://<domain>/auth/realms/oneleft/broker/google/endpoint. Empty: the Google button does not work
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email of Keycloak (HU-067) through Amazon SES (SMTP credentials of SES, STARTTLS on 587)
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_FROM=no-reply@oneleft.example.com
SMTP_USER=
SMTP_PASSWORD=

# Profile photos (HU-020): Lightsail bucket, with CORS allowing PUT from https://<domain> and a key of its own
STORAGE_ENDPOINT=https://s3.eu-west-1.amazonaws.com
STORAGE_BUCKET=
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Web Push keys of the notifications service (./generate-vapid-keys.sh). Empty: notices only inside the app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Daily copy of PostgreSQL (pg_dumpall) to a private Lightsail bucket, at BACKUP_TIME (UTC), kept BACKUP_KEEP_DAYS
BACKUP_BUCKET=
BACKUP_REGION=eu-west-1
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14

# Grafana (--profile observability), under https://<domain>/grafana
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=
