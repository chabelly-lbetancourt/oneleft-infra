# Local development environment variables. Copy to .env (it is not committed).
# These credentials are for local development only: they are never used in AWS.
POSTGRES_USER=oneleft
POSTGRES_PASSWORD=oneleft-dev
RABBITMQ_USER=oneleft
RABBITMQ_PASSWORD=oneleft-dev
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=admin-dev
# Keys of the S3-compatible storage of the profile photos (HU-020), Versity S3 Gateway. Deployed, the keys of the
# S3 or Lightsail bucket go in the environment of users
STORAGE_ACCESS_KEY=oneleft
STORAGE_SECRET_KEY=oneleft-dev-storage
# Secret of the oneleft-accounts client of Keycloak (HU-045): with it the users service deletes accounts. Local only.
# A Keycloak that already exists gets the client with keycloak/sync-accounts-client.sh
ACCOUNTS_CLIENT_SECRET=oneleft-accounts-dev
# Google as identity provider of Keycloak (HU-021). OAuth client created in Google Cloud Console with the
# redirect URI http://localhost:8180/realms/oneleft/broker/google/endpoint. Empty: the Google button does not work
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push keys of the notifications service (HU-006), generated with ./generate-vapid-keys.sh --write.
# Empty: the notices of nearby plans only arrive inside the app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# SMTP server of Keycloak for email verification and password reset (HU-067). Empty: Mailpit captures the emails
# (inbox at http://localhost:8025). Production sets a real server, e.g. Amazon SES with SMTP_AUTH=true and STARTTLS
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_AUTH=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=
SMTP_SSL=

# A plan from a sentence (HU-010): the key of the Anthropic API. Empty: the feature answers «not available»
ANTHROPIC_API_KEY=
